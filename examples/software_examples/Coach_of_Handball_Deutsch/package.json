            ".env"
        ]
    },
    "dependencies": {
        "axios": "^1.13.6",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "helmet": "^7.1.0",
        "redact-pii": "^3.4.0",
        "ws": "^8.16.0",
        "dotenv": "^16.4.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.40.0",
        "pkg": "^5.8.1"
    }
}