{
    "name": "coach-of-handball-deutsch",
    "version": "1.0.0",
    "description": "AI Coaching Software per Coach of Handball Deutsch",
    "main": "server.js",
    "bin": "server.js",
    "scripts": {
        "start": "node server.js",
        "test": "npx playwright test",
        "build": "pkg . --targets node18-win-x64 --no-bytecode --public --output dist/CoachOfHandballDeutsch.exe"
    },
    "pkg": {
